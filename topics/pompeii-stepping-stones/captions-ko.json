{
  "sentences": [
    [
      [
        "폼페이 사람들은"
      ],
      [
        "길 한가운데",
        "커다란 돌을 놓았습니다."
      ]
    ],
    [
      [
        "길을 막으려던 걸까요?"
      ],
      [
